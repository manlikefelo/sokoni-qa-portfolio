# Copy to .env before running the app.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-me-with-at-least-32-characters-of-random"
AUTH_URL="http://localhost:3000"
NODE_ENV="development"

# Set only for local and CI test runs. Enables /api/test-support/* so the suite can
# clear rate-limit buckets between specs. Leave unset in production, where those
# routes answer 404 whatever this holds.
TEST_SUPPORT_TOKEN="local-test-support-token-value"
