        { "sku": "R1", "unitPriceCents": 104525, "quantity": 1 },
        { "sku": "R2", "unitPriceCents": 104525, "quantity": 1 },
        { "sku": "R3", "unitPriceCents": 104525, "quantity": 1 },
        { "sku": "R4", "unitPriceCents": 104525, "quantity": 1 },
