        { "sku": "R9", "unitPriceCents": 104525, "quantity": 1 },
        { "sku": "R10", "unitPriceCents": 104525, "quantity": 1 }
      ],
      "promo": { "code": "SAVE10", "type": "PERCENTAGE", "value": 10, "minSpendCents": 0 },
